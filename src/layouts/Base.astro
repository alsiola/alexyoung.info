---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import alex from '../assets/alex.png';

interface Article { published: Date; modified?: Date; }
interface Props { title?: string; description?: string; article?: Article; }
const { title, description = 'Alex Young builds software, agents and the odd quantum experiment.', article } = Astro.props;
const fullTitle = title ? `${title} | Alex Young` : 'Alex Young';
const path = Astro.url.pathname;
const site = Astro.site!;
const canonical = new URL(path, site).href;
const ogImage = new URL((await getImage({ src: alex, width: 1200, format: 'jpg' })).src, site).href;

const person = {
  '@type': 'Person',
  '@id': new URL('/#person', site).href,
  name: 'Alex Young',
  url: site.href,
  image: ogImage,
  jobTitle: 'Software engineer',
  description: 'Software engineer, previously a vet, building tools that let coding agents take on longer, messier work.',
  sameAs: ['https://github.com/alsiola'],
};
const graph: Record<string, unknown>[] = [
  person,
  { '@type': 'WebSite', '@id': new URL('/#website', site).href, url: site.href, name: 'Alex Young', author: { '@id': person['@id'] } },
];
if (article) {
  graph.push({
    '@type': 'BlogPosting',
    headline: title,
    description,
    url: canonical,
    mainEntityOfPage: canonical,
    datePublished: article.published.toISOString(),
    dateModified: (article.modified ?? article.published).toISOString(),
    author: { '@id': person['@id'] },
    publisher: { '@id': person['@id'] },
    image: ogImage,
  });
}
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
const nav = [
  { href: '/about/', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: '/thoughts/', label: 'Thoughts' },
  { href: '/contact/', label: 'Contact' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Alex Young" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Alex Young" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_GB" />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article && <meta property="article:author" content="Alex Young" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={jsonLd} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Alex Young: Thoughts" href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="LLM summary" href="/llms.txt" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <meta name="theme-color" content="#0c0b09" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="mark" aria-label="Home">Alex Young</a>
        <nav>
          {nav.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="wrap bar">
        <span class="mono">© {new Date().getFullYear()} Alex Young</span>
        <span class="mono">
          <a href="https://github.com/alsiola">GitHub</a> · <a href="/rss.xml">RSS</a>
        </span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; backdrop-filter: blur(12px); background: color-mix(in srgb, var(--bg) 72%, transparent); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 64px; }
  .mark { font-family: var(--serif); font-size: 26px; text-decoration: none; line-height: 1; white-space: nowrap; }
  nav { display: flex; gap: clamp(14px, 3vw, 36px); }
  nav a { font-size: 15px; text-decoration: none; color: var(--ink-dim); transition: color .2s; }
  nav a:hover, nav a[aria-current] { color: var(--ink); }
  @media (max-width: 520px) { nav a { font-size: 14px; } .mark { font-size: 22px; } }
  .site-footer { border-top: 1px solid var(--line); color: var(--ink-dim); }
  .site-footer a { text-decoration: none; }
  .site-footer a:hover { color: var(--accent); }
</style>
