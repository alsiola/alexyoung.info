---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('thoughts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={post.data.title} description={post.data.description}>
  <article class="wrap">
    <header class="head">
      <a href="/thoughts/" class="back">All posts</a>
      <h1 class="display rise">{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <time class="mono" datetime={post.data.date.toISOString()}>{date}</time>
    </header>
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  .head { padding-top: clamp(56px, 10vw, 128px); padding-bottom: 0; max-width: 960px; }
  .back { color: var(--ink-dim); text-decoration: none; }
  .back:hover { color: var(--accent); }
  h1 { font-size: clamp(52px, 8vw, 112px); margin: 28px 0 24px; line-height: .95; }
  .lede { font-size: 21px; color: var(--ink-dim); max-width: 640px; margin: 0 0 24px; }
  time { color: var(--ink-dim); }
  .prose { max-width: 680px; padding-top: 40px; padding-bottom: 120px; font-size: 19px; line-height: 1.7; }
  .prose :global(h2) { font-family: var(--serif); font-weight: 400; font-size: 40px; line-height: 1.1; margin: 2em 0 .5em; }
  .prose :global(h3) { font-size: 20px; margin: 2em 0 .5em; }
  .prose :global(a) { color: var(--accent); text-underline-offset: 3px; }
  .prose :global(blockquote) { margin: 2em 0; padding-left: 24px; border-left: 2px solid var(--accent); font-family: var(--serif); font-size: 28px; line-height: 1.3; font-style: italic; }
  .prose :global(code) { font-family: var(--mono); font-size: .85em; background: var(--bg-2); padding: .15em .4em; border: 1px solid var(--line); }
  .prose :global(pre) { background: var(--bg-2) !important; border: 1px solid var(--line); padding: 20px; overflow-x: auto; font-size: 14px; }
  .prose :global(pre code) { background: none; border: 0; padding: 0; }
  .prose :global(img) { max-width: 100%; height: auto; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 3em 0; }
</style>
