---
import Base from '../layouts/Base.astro';
import FlowField from '../components/FlowField.astro';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import alex from '../assets/alex.png';

const thoughts = (await getCollection('thoughts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Base>
  <section class="hero">
    <FlowField />
    <Image src={alex} alt="Alex Young" class="portrait" widths={[430, 860]} sizes="(max-width: 760px) 70vw, 45vw" loading="eager" fetchpriority="high" />
    <div class="wrap hero-inner">
      <h1 class="display rise">Alex Young</h1>
      <div class="hero-foot rise" style="animation-delay:.15s">
        <p>Software engineer, previously a vet. Right now I'm mostly building tools that let coding agents take on longer, messier work.</p>
        <p class="links"><a href="/projects/">Projects</a> <a href="/about/">About me</a></p>
      </div>
    </div>
  </section>

  <section class="wrap block">
    <div class="block-head">
      <h2>Projects</h2>
      <a class="more" href="/projects/">All projects</a>
    </div>
    <ul class="rows">
      {projects.map((p) => (
        <li>
          <a href={`/projects/#${p.slug}`}>
            <span class="name">{p.name}</span>
            <span class="tag">{p.tagline}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap block">
    <div class="block-head">
      <h2>Thoughts</h2>
      <a class="more" href="/thoughts/">All posts</a>
    </div>
    {thoughts.length === 0 ? (
      <p class="empty">Nothing here yet.</p>
    ) : (
      <ul class="rows">
        {thoughts.map((t) => (
          <li>
            <a href={`/thoughts/${t.id}/`}>
              <span class="name">{t.data.title}</span>
              <span class="tag">{t.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="wrap block contact">
    <p>Want to get in touch? <a href="/contact/">Send me a message</a>.</p>
  </section>
</Base>

<style>
  .hero { position: relative; min-height: calc(100dvh - 64px); display: flex; align-items: flex-end; overflow: hidden; border-bottom: 1px solid var(--line); }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, var(--bg) 0%, transparent 45%); pointer-events: none; }
  .hero-inner { position: relative; z-index: 1; padding-bottom: clamp(32px, 6vw, 72px); }
  .portrait { position: absolute; right: clamp(-40px, 2vw, 64px); bottom: 0; height: min(92%, 1000px); width: auto; z-index: 1; pointer-events: none; -webkit-mask-image: linear-gradient(to top, transparent 0%, #000 22%); mask-image: linear-gradient(to top, transparent 0%, #000 22%); animation: rise 1.2s .15s cubic-bezier(.2,.7,.2,1) both; }
  @media (max-width: 760px) { .portrait { top: 2%; bottom: auto; left: 0; right: 0; margin: 0 auto; height: auto; width: min(88%, 420px); max-height: 54%; object-fit: contain; object-position: top; -webkit-mask-image: linear-gradient(to top, transparent 0%, #000 40%); mask-image: linear-gradient(to top, transparent 0%, #000 40%); } }
  @media (prefers-reduced-motion: reduce) { .portrait { animation: none; } }
  .hero-inner { z-index: 2 !important; }
  .hero h1 { font-size: clamp(80px, min(16vw, 26dvh), 260px); margin: 0 0 28px -0.04em; max-width: 8ch; }
  .hero-foot { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .hero-foot p { max-width: 460px; margin: 0; font-size: clamp(17px, 1.6vw, 20px); color: var(--ink); }
  .hero-foot .links { display: flex; gap: 24px; }
  .hero-foot .links a { text-underline-offset: 4px; text-decoration-color: var(--accent); }
  .hero-foot .links a:hover { color: var(--accent); }

  .block { padding-top: clamp(64px, 10vw, 128px); }
  .block-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 16px; }
  .block-head h2 { font-size: 15px; font-weight: 500; margin: 0; }
  .more { color: var(--ink-dim); font-size: 15px; text-underline-offset: 4px; }
  .more:hover { color: var(--accent); }
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .rows li { border-bottom: 1px solid var(--line); }
  .rows a { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); align-items: baseline; gap: 8px 32px; padding: 24px 0; text-decoration: none; }
  .rows a:hover .name { color: var(--accent); }
  .name { font-family: var(--serif); font-size: clamp(32px, 4vw, 48px); line-height: 1.05; transition: color .2s; }
  .tag { color: var(--ink-dim); }
  @media (max-width: 760px) { .rows a { grid-template-columns: 1fr; } }
  .empty { color: var(--ink-dim); border-top: 1px solid var(--line); padding-top: 24px; margin: 0; }
  .contact { padding-bottom: clamp(64px, 10vw, 128px); }
  .contact p { font-size: clamp(22px, 2.4vw, 30px); margin: 0; }
  .contact a { color: var(--accent); text-underline-offset: 5px; }
</style>
