---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import alex from '../assets/alex.png';

const roles = [
  { when: '2026 –', role: 'Staff Backend Engineer', org: 'Thrive Learning', detail: 'Leading the backend function across a 50-strong engineering department, and architecting the customer-facing autonomous AI agent platform.' },
  { when: '2024 – 26', role: 'Senior Product Engineer', org: 'HiveHR', detail: 'Shipped a new product, added distributed tracing, and built generative AI features.' },
  { when: '2022 – 24', role: 'Head of Engineering', org: 'Clinchd', detail: 'Led a team of five and set technical direction for the company. Introduced continuous release and feature flags.' },
  { when: '2020 – 22', role: 'Senior Backend Engineer', org: 'Impala Travel Technology', detail: 'Led a team on feature delivery and platform scalability, and aligned backend direction across teams.' },
  { when: '2016 – 20', role: 'Lead Engineer', org: 'HiveHR', detail: 'Engineer number two. Grew a proof of concept into an event-driven microservices platform and a team of eight.' },
  { when: 'Before', role: 'Veterinary surgeon', org: 'BVSc, University of Liverpool', detail: 'Private practice, a university teaching hospital, then freelance equine anaesthesia.' },
];

const skills = [
  { group: 'AI & agents', items: ['Agent platforms', 'Agent orchestration', 'Tool calling', 'Evals', 'Vector search', 'Embedding pipelines', 'Model selection', 'Claude Code'] },
  { group: 'Backend', items: ['Node.js', 'TypeScript', 'Fastify', 'NestJS', 'Express', 'GraphQL', 'Event-driven microservices', 'Go', 'Python'] },
  { group: 'Data', items: ['PostgreSQL', 'MongoDB', 'Redis', 'DynamoDB', 'CosmosDB', 'ETL pipelines'] },
  { group: 'Cloud & infra', items: ['AWS', 'ECS', 'Lambda', 'S3', 'Event systems', 'Terraform', 'Docker'] },
  { group: 'Reliability', items: ['CI/CD', 'Observability', 'Distributed tracing', 'Alerting', 'Load testing', 'Feature flags'] },
  { group: 'Frontend & leadership', items: ['React', 'Astro', 'PWAs', 'Technical leadership', 'Mentoring', 'Async decision making'] },
];
---
<Base title="About" description="Vet turned software engineer, now working on agent orchestration.">
  <section class="wrap intro">
    <div class="text">
      <h1 class="display rise">About</h1>
      <p class="lede">
        I trained as a vet and worked in private practice and at a university teaching hospital, then
        as a freelance equine anaesthetist. I'd always written code on the side, and at 30 I switched
        careers. I've been a software engineer for twelve years since, at startups, scaleups and
        larger companies.
      </p>
      <p class="lede dim">
        At the moment I'm most interested in agent orchestration. Most of my spare time goes into
        getting agents to reliably finish longer pieces of work.
      </p>
    </div>
    <div class="photo">
      <Image src={alex} alt="Alex Young" widths={[360, 720]} sizes="(max-width: 860px) 70vw, 360px" />
    </div>
  </section>

  <section class="wrap block">
    <h2>Experience</h2>
    <ol class="roles">
      {roles.map((r) => (
        <li>
          <span class="mono when">{r.when}</span>
          <span class="role"><span class="what">{r.role}</span><span class="org">{r.org}</span></span>
          <span class="detail">{r.detail}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap block last">
    <h2>Skills</h2>
    <div class="skills">
      {skills.map((s) => (
        <div class="group">
          <h3>{s.group}</h3>
          <p>{s.items.join(', ')}</p>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .intro { display: grid; grid-template-columns: 1fr 360px; gap: clamp(32px, 6vw, 96px); align-items: end; padding-top: clamp(56px, 10vw, 128px); padding-bottom: 0; }
  h1 { font-size: clamp(56px, 9vw, 128px); margin: 0 0 32px; }
  .lede { font-size: 20px; max-width: 620px; margin: 0 0 20px; }
  .lede.dim { color: var(--ink-dim); }
  .photo { position: relative; }
  .photo :global(img) { width: 100%; height: auto; display: block; -webkit-mask-image: linear-gradient(to top, transparent 0%, #000 25%); mask-image: linear-gradient(to top, transparent 0%, #000 25%); }

  .block { padding-top: clamp(48px, 7vw, 88px); }
  .block.last { padding-bottom: clamp(72px, 10vw, 128px); }
  .block h2 { font-size: 15px; font-weight: 500; margin: 0 0 16px; }
  .roles { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .roles li { display: grid; grid-template-columns: 110px minmax(0, 1fr) minmax(0, 1.4fr); gap: 8px 32px; align-items: baseline; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .when { color: var(--ink-dim); font-size: 13px; }
  .role { display: flex; flex-direction: column; gap: 4px; }
  .what { font-family: var(--serif); font-size: clamp(24px, 2.6vw, 32px); line-height: 1.1; }
  .org { color: var(--ink-dim); font-size: 15px; }
  .detail { color: var(--ink-dim); }
  .skills { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 40px; border-top: 1px solid var(--line); padding-top: 24px; }
  .group h3 { font-size: 15px; font-weight: 500; margin: 0 0 6px; }
  .group p { margin: 0; color: var(--ink-dim); }
  @media (max-width: 860px) {
    .intro { grid-template-columns: 1fr; }
    .photo { max-width: 300px; order: -1; }
    .skills { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .roles li { grid-template-columns: 1fr; }
    .skills { grid-template-columns: 1fr; }
  }
</style>
