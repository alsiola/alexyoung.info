<canvas id="flow" aria-hidden="true"></canvas>

<style>
  #flow { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
</style>

<script>
  const canvas = document.getElementById('flow') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let w = 0, h = 0, dpr = 1, t = 0, raf = 0, running = true;
  const mouse = { x: -9999, y: -9999 };
  type P = { x: number; y: number; life: number; hot: boolean };
  let ps: P[] = [];

  function spawn(p?: P): P {
    const q = p ?? ({} as P);
    q.x = Math.random() * w; q.y = Math.random() * h;
    q.life = 80 + Math.random() * 220; q.hot = Math.random() < 0.18;
    return q;
  }
  function resize() {
    dpr = Math.min(devicePixelRatio || 1, 2);
    const r = canvas.getBoundingClientRect();
    w = r.width; h = r.height;
    canvas.width = w * dpr; canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.fillStyle = '#0c0b09'; ctx.fillRect(0, 0, w, h);
    const n = Math.round(Math.min(1400, (w * h) / 900));
    ps = Array.from({ length: n }, () => spawn());
  }
  // cheap smooth pseudo-noise field
  function angle(x: number, y: number) {
    const s = 0.0024;
    return (
      Math.sin(x * s + t * 0.6) * 1.4 +
      Math.cos(y * s * 1.3 - t * 0.4) * 1.4 +
      Math.sin((x + y) * s * 0.6 + t * 0.25) * 1.2
    );
  }
  function frame() {
    t += 0.004;
    ctx.fillStyle = 'rgba(12,11,9,0.06)';
    ctx.fillRect(0, 0, w, h);
    ctx.lineWidth = 1;
    for (const p of ps) {
      let a = angle(p.x, p.y);
      const dx = p.x - mouse.x, dy = p.y - mouse.y, d2 = dx * dx + dy * dy;
      if (d2 < 30000) a += Math.atan2(dy, dx) * (1 - d2 / 30000) * 1.5;
      const nx = p.x + Math.cos(a) * 1.4, ny = p.y + Math.sin(a) * 1.4;
      ctx.strokeStyle = p.hot ? 'rgba(255,90,31,0.55)' : 'rgba(237,230,216,0.16)';
      ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(nx, ny); ctx.stroke();
      p.x = nx; p.y = ny;
      if (--p.life < 0 || nx < 0 || nx > w || ny < 0 || ny > h) spawn(p);
    }
    if (running) raf = requestAnimationFrame(frame);
  }
  function start() { if (!running) { running = true; raf = requestAnimationFrame(frame); } }
  function stop() { running = false; cancelAnimationFrame(raf); }

  resize();
  addEventListener('resize', () => { resize(); if (reduce) for (let i = 0; i < 300; i++) frame(); });
  addEventListener('pointermove', (e) => {
    const r = canvas.getBoundingClientRect();
    mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
  });
  if (reduce) {
    running = false;
    for (let i = 0; i < 300; i++) frame(); // a still, pre-drawn field
  } else {
    raf = requestAnimationFrame(frame);
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  }
</script>
